# ==============================================================================
# GST Intelligence Frontend - Environment Configuration
# ==============================================================================
# Optional: Set the backend API base URL for remote deployments.
# - In local development: leave empty to let Vite proxy /api to http://127.0.0.1:8000
# - In Vercel production: set to your deployed backend URL (e.g. Render, Railway, Fly.io)
#   Example: https://gst-backend-api.onrender.com
VITE_API_BASE_URL=
